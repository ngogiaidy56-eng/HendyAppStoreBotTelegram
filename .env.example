# Example values only. Never put real credentials in this file.
# BOT_TOKEN is only used by Platform API to verify Telegram Mini App initData; no Bot Worker is deployed.
# Set real values in GitHub Actions Secrets / Cloudflare Worker Runtime Secrets.
# Used only to verify Telegram Mini App initData; set a rotated token in protected runtime secrets.
BOT_TOKEN=replace-with-a-new-mini-app-bot-token
SESSION_SECRET=replace-with-at-least-32-random-bytes
ADMIN_TELEGRAM_IDS=replace-with-admin-telegram-id
BOT_USERNAME=replace-with-existing-mini-app-bot-username

# Public Pages / API origins (production URLs are resolved by the deploy workflow)
VITE_API_BASE_URL=https://hendy-platform-api.<workers-subdomain>.workers.dev
APP_URL=https://hendy-mini-app.pages.dev
ADMIN_URL=https://hendy-web-admin.pages.dev
STOREFRONT_URL=https://hendy-web-user.pages.dev
CORS_ORIGINS=https://hendy-mini-app.pages.dev,https://hendy-web-admin.pages.dev,https://hendy-web-user.pages.dev

# D1 wallet/deposit limits and feature configuration
MIN_DEPOSIT_VND=10000
MAX_DEPOSIT_VND=100000000
DAILY_CHECKIN_REWARD_VND=1000
REFERRAL_REWARD_VND=2000
TASKS_CONFIG_JSON={"maxActiveTasks":20,"maxTargetCount":100000,"maxRewardVnd":1000000000}
MINIGAME_CONFIG_JSON={"prizes":[{"key":"jackpot","threshold":5,"rewardVnd":5000},{"key":"bonus","threshold":50,"rewardVnd":1000},{"key":"small","threshold":150,"rewardVnd":200},{"key":"try_again","threshold":795,"rewardVnd":0}]}

# Bank adapter (leave unset until provider integration/signature contract is verified)
BANK_ID=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
BANK_WEBHOOK_SECRET=
BANK_API_KEY=
BANK_API_SECRET=
BANK_SYNC_URL=

# GitHub integration. Store tokens as secrets, not here.
GITHUB_OWNER=ngogiaidy56-eng
GITHUB_REPO=HendyAppStoreBotTelegram
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Optional Cloudflare resource IDs. The provisioning workflow can discover/create these.
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_D1_DATABASE_ID=replace-with-d1-database-id
CLOUDFLARE_DEDUPE_KV_NAMESPACE_ID=replace-with-kv-namespace-id
