# Local-only examples. Do not put real values here or commit .env/.dev.vars.
# Telegram auth and webhook
BOT_TOKEN=
BOT_WEBHOOK_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-at-least-32-random-bytes
ADMIN_TELEGRAM_IDS=123456789
BOT_USERNAME=

# API/Frontend origins
VITE_API_BASE_URL=http://127.0.0.1:8787
APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# D1 wallet/deposit limits
MIN_DEPOSIT_VND=10000
MAX_DEPOSIT_VND=100000000
DAILY_CHECKIN_REWARD_VND=1000
REFERRAL_REWARD_VND=2000
TASKS_CONFIG_JSON={"maxActiveTasks":20,"maxTargetCount":100000,"maxRewardVnd":1000000000}
MINIGAME_CONFIG_JSON={"prizes":[{"key":"jackpot","threshold":5,"rewardVnd":5000},{"key":"bonus","threshold":50,"rewardVnd":1000},{"key":"small","threshold":150,"rewardVnd":200},{"key":"try_again","threshold":795,"rewardVnd":0}]}

# Bank adapter (leave unset until provider integration and signature contract are verified)
BANK_ID=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
BANK_WEBHOOK_SECRET=
BANK_API_KEY=
BANK_API_SECRET=
# Optional Queue Processor endpoint. Leave unset until the bank/provider contract is verified.
BANK_SYNC_URL=

# GitHub integration; use a least-privilege repo token stored only as a Worker secret.
GITHUB_OWNER=hendyngo-servers
GITHUB_REPO=HendyAppStoreBotTelegram
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Cloudflare IDs are deployment identifiers, not credentials. Set in GitHub Actions Variables.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_DEDUPE_KV_NAMESPACE_ID=
